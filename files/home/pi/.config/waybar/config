{
    "layer": "top",
    "modules-left": [
        "custom/keyboard",
        "custom/cheatsheet"
    ],
    "modules-center": [
        "sway/window"
    ],
    "modules-right": [
        "clock",
        "custom/audio",
        "custom/network",
        "custom/euphonica",
        "custom/power"
    ],
    "fixed-center": false,
    "expand-center": true,
    "sway/window": {
        "format": "{}",
        "max-length": 100,
        "expand": true,
        "rewrite": {
            "swayimg: cheatsheet\\.svg": "cheatsheet"
        }
    },
    "custom/audio": {
        "exec": "/bin/bash $HOME/.config/sway/audio-mode.sh status --waybar",
        "interval": 5,
        "signal": 8,
        "format": " {} ",
        "tooltip-format": "Audio mode (click to switch)",
        "on-click": "/bin/bash $HOME/.config/sway/audio-mode.sh pick",
        "spacing": 10
    },
    "custom/network": {
        "format": " \uf1eb ",
        "tooltip-format": "Network (wifitui)",
        "on-click": "/bin/bash $HOME/.config/sway/network.sh",
        "spacing": 10
    },
    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "custom/keyboard": {
        "format": "  ",
        "tooltip-format": "Keyboard",
        "on-click": "/bin/bash $HOME/.config/waybar/wvkeyboard.sh",
        "spacing": 10
    },
    "custom/cheatsheet": {
        "format": " ? ",
        "tooltip-format": "Cheatsheet",
        "on-click": "/bin/bash $HOME/.config/sway/cheatsheet.sh",
        "spacing": 10
    },

    "custom/euphonica": {
        "format": " \uf025 ",
        "tooltip-format": "Euphonica",
        "on-click": "/bin/bash $HOME/.config/waybar/euphonica.sh",
        "spacing": 10
    },
    "custom/power": {
        "format": "  ",
        "tooltip": false,
        "on-click": "wlogout -L 140 -R 140 -T 230 -B 230"
    }
}
