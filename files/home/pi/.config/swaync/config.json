{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "user",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 8,
  "control-center-margin-right": 8,
  "control-center-margin-left": 8,
  "notification-window-width": 360,
  "control-center-width": 360,
  "control-center-height": 480,
  "transition-time": 200,
  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "timeout": 6,
  "timeout-low": 5,
  "timeout-critical": 0,
  "image-visibility": "when-available",
  "notification-visibility": {
    "Euphonica": {
      "state": "transient",
      "app-name": "Euphonica"
    },
    "io.github.htkhiem.Euphonica": {
      "state": "transient",
      "app-name": "io.github.htkhiem.Euphonica"
    },
    "mpd-notify": {
      "state": "muted",
      "app-name": "mpd-notify"
    }
  },
  "widgets": ["mpris", "inhibitors", "title", "dnd", "notifications"],
  "widget-config": {
    "mpris": {
      "image-size": 96,
      "autohide": false,
      "show-album-art": "when-available",
      "loop-carousel": true,
      "blacklist": ["io.github.htkhiem.Euphonica"]
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
