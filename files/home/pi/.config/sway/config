# HackPi sway config (template payload).
#
# This file is the single source of truth for the sway session: it is copied
# verbatim by setup-pi.sh (no sed patching of a distro config). Music and
# cheatsheet binds are generated from keys.json -> generated.conf and included
# at the end so they always win any collision.
#
# Portable template rules: no baked /home/pi or /run/user/1000. sway expands
# ~ and shell syntax in include/exec/output paths (wordexp), so ~ is safe here.

### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Terminal emulator (launched floating via keys.json $mod+tab).
set $term foot
# Application launcher (launched via keys.json $mod+space).
set $menu fuzzel

# Distro drop-ins. /etc/sway/config.d/50-systemd-user.conf imports
# WAYLAND_DISPLAY/SWAYSOCK/etc into the systemd user environment, which the
# user services (waybar, mpd, swaync, ...) need. Keep these includes.
include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*

### Output configuration
#
# Wallpaper ships in the payload (~/wallpaper/wallpaper.jpg; Unsplash photo by
# Daniel Olah, Unsplash license - see wallpaper.attribution.txt). sway errors on a
# missing file, so the asset must be deployed with the config.
output * bg ~/wallpaper/wallpaper.jpg fill

### Input configuration
#
# The Hackberry keyboard needs a snappy repeat; toggles/launchers additionally
# use --no-repeat from keys.json so held keys cannot thrash hide/show pairs.
input "16962:3:ZitaoTech_HackberryPi9900" {
    repeat_delay 300
    repeat_rate 35
}

### Appearance
#
font pango:monospace 1
default_border pixel 1
default_floating_border pixel 1
titlebar_border_thickness 0
titlebar_padding 0
hide_edge_borders --i3 smart_no_gaps
floating_minimum_size 420 x 240
floating_maximum_size 720 x 700
seat seat0 hide_cursor 3000

# Dracula palette.
client.focused #bd93f9 #bd93f9 #282a36 #bd93f9 #bd93f9
client.focused_inactive #6272a4 #6272a4 #f8f8f2 #6272a4 #6272a4
client.unfocused #44475a #44475a #f8f8f2 #44475a #44475a
client.urgent #ff5555 #ff5555 #f8f8f2 #ff5555 #ff5555
client.placeholder #44475a #44475a #f8f8f2 #44475a #44475a
client.background #282a36

### Key bindings
#
# Stock base, trimmed for the Hackberry: every bind that collides with a
# keys.json key is simply absent here (no unbindsym needed, because this file
# does not include /etc/sway/config). Collisions handled:
#   $mod+Return  terminal  -> keys.json $mod+Return (notification center); terminal is $mod+tab
#   $mod+d       launcher  -> keys.json $mod+d (PipeWire output switcher); $mod+space is fuzzel
#   $mod+j/$mod+k focus    -> keys.json $mod+j/$mod+k (mpc seek)
#   $mod+s layout          -> keys.json $mod+s (mpc single)
#   $mod+v splitv          -> keys.json $mod+v (wiremix)
#   $mod+r resize mode     -> keys.json $mod+r (mpc random); resize moved to $mod+Shift+r
#   $mod+space mode_toggle -> remapped to $mod+t (space is fuzzel)
#   $mod+Shift+space float -> remapped to $mod+Shift+t
#   $mod+1/$mod+2 view     -> remapped to $mod+w/$mod+e (see Workspaces)
#   $mod+Shift+[0-9] move  -> all dropped: the Hackberry dollar key sends
#                            Shift+4 and shifted numbers are a trap on this
#                            board; $mod+Shift+4 is Euphonica.
#
# Basics:
#
    # Kill focused window
    bindsym $mod+Shift+q kill

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around (h/l only; j/k belong to mpc seek)
    bindsym $mod+$left focus left
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace. 1/2 use letter keys (w/e) because the number row's
    # shifted forms are unreliable on this keyboard; 3..10 keep the number row.
    bindsym $mod+w workspace number 1
    bindsym $mod+e workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
#
# Layout stuff:
#
    # Horizontal split ($mod+v is wiremix, so no splitv bind).
    bindsym $mod+b splith

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+t floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+t focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+Shift+r mode "default"
}
bindsym $mod+Shift+r mode "resize"
#
# Utilities:
#
    # Hardware media keys route through volume.sh so notifications stay
    # consistent with the $mod+i/$mod+o/$mod+m binds (pactl is not installed;
    # PipeWire is the sound server).
    bindsym --locked XF86AudioMute exec ~/.config/sway/volume.sh mute
    bindsym --locked XF86AudioLowerVolume exec ~/.config/sway/volume.sh down
    bindsym --locked XF86AudioRaiseVolume exec ~/.config/sway/volume.sh up

    # Screenshot (grim is installed on the live Pi).
    bindsym Print exec grim

### Window rules
#
# Cheatsheet overlay: for_window move is relative to the workspace content
# origin (below waybar, y=43), so 10,57 lands at absolute 10,100.
for_window [app_id="cheatsheet"] floating enable, resize set 700 520, move position 10 57, border none
for_window [app_id="imv"] floating enable, resize set 700 520, move position 10 100, border none
for_window [app_id="wiremix"] resize set height 320 px
for_window [app_id="foot"] floating enable, resize set 640 480, move position center, border none
for_window [app_id="bluetooth"] floating enable, resize set 640 480, move position center, border none

# Workspace placement: music player + wiremix on 1:Music, browser on
# 2:Browser. The terminal always opens floating on the current workspace.
# The launcher helpers (*.sh) switch to the right workspace before launching.
assign [app_id="io.github.htkhiem.Euphonica"] "1:Music"
assign [app_id="wiremix"] "1:Music"
assign [app_id="firefox"] "2:Browser"

### Session
#
# Waybar is the only bar; sway's own bar block is intentionally absent.
exec --no-startup-id waybar
# swaync via sway: the unit's graphical-session.target WantedBy never
# activates on this image, so an enabled unit alone leaves notifications dead.
exec --no-startup-id systemctl --user start swaync.service
exec --no-startup-id devmon
exec --no-startup-id nm-applet --indicator &
exec swaymsg 'workspace "1:Music"; exec flatpak --user run --env=GSK_RENDERER=cairo io.github.htkhiem.Euphonica'

### Music / cheatsheet keys
#
# Generated from keys.json by generate-keys.sh - do not edit by hand.
# Included last so generated binds always win.
include ~/.config/sway/generated.conf
