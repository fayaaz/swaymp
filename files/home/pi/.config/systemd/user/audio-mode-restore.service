[Unit]
Description=Bring the Snapcast audio mode up Off at boot
Documentation=man:snapserver(1)
# MPD persists audio-output enable states (state_file), so a Pi that shut down
# in Broadcast/Group comes back with the Multiroom fifo output enabled. This
# oneshot forces the mode Off (silently) once MPD can answer: it clears that
# stale output state and stops snapserver/snapclient instead of re-joining a
# room the Pi was in before the reboot. audio-mode.sh polls mpc outputs first.
After=mpd.service snapclient.service
Wants=mpd.service

[Service]
Type=oneshot
ExecStart=%h/.config/sway/audio-mode.sh restore

[Install]
WantedBy=default.target
