# raw snapshots of the running Pi (reference only, never committed)
hackpi-backup/
hackpi-full-backup/
hackpi-config-backup.tar.gz

# prebuilt/compiled binaries (no source in this repo; build on the target)
files/home/pi/.cargo/bin/
*.so
*.o
*.a
*.obj
*.exe

# archives (setup tarballs are built on demand, never committed)
*.tar
*.tar.gz
*.tgz
*.zip

# private keys / certificates (services regenerate these on a fresh deploy)
*.pem
*.key
csrftokens.txt
files/home/pi/.config/mympd/ssl/
files/home/pi/.config/mympd/config/pin_hash

# demo build outputs (regenerated by demo/make.sh; source clip hackpi-overlay.mp4 is tracked)
demo/kb_final.webm
demo/kb_final.mp4

# runtime state and caches (rebuilt by mpd/mympd/syncthing)
files/home/pi/.config/mpd/state
files/home/pi/.config/mpd/tag_cache
files/home/pi/.config/mpd/sticker.sql
files/home/pi/.config/mympd/tags/
files/home/pi/.config/mympd/state/default/last_played_list.mpack
files/home/pi/.config/syncthing/index-v0.14.0.db/
files/home/pi/.config/syncthing/syncthing.log

# personal agent notes (local only)
.opencode/
