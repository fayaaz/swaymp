{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": false,
  "cssPriority": "application",
  "control-center-margin-top": 0,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 0,
  "control-center-margin-left": 0,
  "notification-window-width": 320,
  "control-center-width": 320,
  "control-center-height": 320,
  "transition-time": 200,
  "keyboard-shortcuts": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No Notifications",
  "timeout": 6,
  "timeout-low": 5,
  "timeout-critical": 0,
  "image-visibility": "when-available",
  "notification-visibility": {
    "Euphonica": {
      "state": "transient",
      "app-name": "Euphonica"
    },
    "io.github.htkhiem.Euphonica": {
      "state": "transient",
      "app-name": "io.github.htkhiem.Euphonica"
    },
    "mpd-notify": {
      "state": "muted",
      "app-name": "mpd-notify"
    }
  },
  "widgets": ["inhibitors", "title", "dnd", "notifications"]
}
