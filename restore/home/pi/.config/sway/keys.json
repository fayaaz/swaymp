{
  "binds": [
    {"key": "$mod+p", "label": "play / pause", "cmd": "exec mpc toggle", "group": "playback"},
    {"key": "$mod+comma", "label": "previous", "cmd": "exec mpc prev", "group": "playback"},
    {"key": "$mod+period", "label": "next", "cmd": "exec mpc next", "group": "playback"},
    {"key": "$mod+j", "label": "seek -5s", "cmd": "exec mpc seek -5", "group": "playback"},
    {"key": "$mod+k", "label": "seek +5s", "cmd": "exec mpc seek +5", "group": "playback"},
    {"key": "$mod+r", "label": "random on/off", "cmd": "exec mpc random", "group": "playback"},
    {"key": "$mod+s", "label": "single on/off", "cmd": "exec mpc single", "group": "playback"},
    {"key": "XF86AudioPlay", "label": "media play", "cmd": "exec mpc toggle", "group": "media"},
    {"key": "XF86AudioNext", "label": "media next", "cmd": "exec mpc next", "group": "media"},
    {"key": "XF86AudioPrev", "label": "media prev", "cmd": "exec mpc prev", "group": "media"},
    {"key": "$mod+i", "label": "volume -", "cmd": "exec ~/.config/sway/volume.sh down", "group": "volume"},
    {"key": "$mod+o", "label": "volume +", "cmd": "exec ~/.config/sway/volume.sh up", "group": "volume"},
    {"key": "$mod+m", "label": "mute", "cmd": "exec ~/.config/sway/volume.sh mute", "group": "volume"},
    {"key": "$mod+v", "label": "wiremix peaks", "cmd": "exec ~/.config/sway/wiremix.sh", "group": "tools"},
    {"key": "$mod+d", "label": "notifications", "cmd": "exec ~/.config/sway/notifications.sh", "group": "tools"},
    {"key": "$mod+space", "label": "launcher (fuzzel)", "cmd": "exec fuzzel", "group": "tools"},
    {"key": "$mod+dollar", "label": "euphonica", "cmd": "exec /bin/bash ~/.config/waybar/euphonica.sh", "group": "tools"},
    {"key": "$mod+g", "label": "browser", "cmd": "exec ~/.config/sway/browser.sh", "group": "tools"},
    {"key": "$mod+tab", "label": "terminal", "cmd": "exec foot", "group": "tools"},
    {"key": "F13", "label": "this cheatsheet", "cmd": "exec ~/.config/sway/cheatsheet.sh", "group": "tools"},
    {"key": "F11", "label": "back / close cheatsheet", "cmd": "exec ~/.config/sway/cheatsheet.sh", "group": "tools"}
  ]
}
